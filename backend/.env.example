# ==============================================================================
# Server & Environment Configuration
# ==============================================================================
NODE_ENV=production
PORT=5000
# The public URL where this backend server is accessible (e.g., https://api.yourdomain.com)
APP_URL=http://localhost:5000
# The URL of the frontend application allowed to make requests (e.g., https://app.yourdomain.com)
FRONTEND_URL=http://localhost:5173
# Optional comma-separated additional allowed CORS origins (e.g., https://admin.yourdomain.com,https://preview.yourdomain.com)
CORS_ORIGIN=
LOG_LEVEL=info

# ==============================================================================
# PostgreSQL Database (Prisma ORM)
# ==============================================================================
# PostgreSQL connection string: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/instagram_ai_db?schema=public

# ==============================================================================
# JWT Authentication Secret
# ==============================================================================
# Generate a strong 64-character random string for production (e.g., openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_production_secret_key_32_chars_min
JWT_EXPIRES_IN=7d

# ==============================================================================
# Meta / Instagram Graph API Configuration
# ==============================================================================
# Created in Meta Developer Portal (developers.facebook.com)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
# Must match the OAuth redirect URI configured in Meta App Settings -> Instagram Graph API
# In production: https://api.yourdomain.com/api/instagram/callback
META_REDIRECT_URI=http://localhost:5000/api/instagram/callback
# Secret verify token configured in Meta Webhooks settings for subscription validation
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your_custom_secure_webhook_verify_token

# ==============================================================================
# AI Provider Configuration (Vercel AI SDK / OpenRouter)
# ==============================================================================
# Primary AI gateway or OpenRouter API key (sk-or-v1-...)
OPENROUTER_API_KEY=your_openrouter_api_key
AI_MODEL=openrouter/free
AI_PROVIDER=openrouter
AI_GATEWAY_API_KEY=

# ==============================================================================
# Optional Infrastructure Services
# ==============================================================================
# Redis URL for background BullMQ workers and distributed rate limiting (optional)
# REDIS_URL=redis://localhost:6379
