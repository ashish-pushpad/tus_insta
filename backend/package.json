{
  "name": "instagram-ai-backend",
  "version": "1.0.0",
  "description": "Production-grade Instagram AI Auto-Reply Platform Backend",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/unit/ --runInBand --forceExit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/integration/ --runInBand --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testRegex": "tests[/\\\\].*\\.test\\.js$",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testTimeout": 30000,
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  },
  "dependencies": {
    "@ai-sdk/openai": "^0.0.15",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/orm-postgres": "^8.0.0-rc.14",
    "ai": "^7.0.77",
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.81.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "pg": "^8.23.1",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prisma": "^7.10.0",
    "supertest": "^7.0.0"
  }
}
