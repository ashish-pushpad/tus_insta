# ==============================================================================
# Full-Stack Deployment Environment Variables (docker-compose)
# ==============================================================================

# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_postgres_password_123
POSTGRES_DB=instagram_ai_db
POSTGRES_PORT=5432

# Redis Cache & Queue
REDIS_PORT=6379

# Backend API Configuration
NODE_ENV=production
PORT=5000
APP_URL=https://api.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com
CORS_ORIGIN=https://app.yourdomain.com
FRONTEND_PORT=80
LOG_LEVEL=info

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_jwt_key_at_least_32_characters
JWT_EXPIRES_IN=7d

# Meta / Instagram Graph API OAuth
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=https://api.yourdomain.com/api/instagram/callback
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=your_custom_secure_webhook_verify_token

# AI Provider (OpenRouter / Vercel AI SDK)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
AI_MODEL=openrouter/free
AI_PROVIDER=openrouter
