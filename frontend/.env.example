# Frontend Environment Configuration
# For local development with Vite dev server proxy, leave empty or set to /api
# For production where frontend and backend are hosted on separate domains:
# VITE_API_BASE_URL=https://your-backend-api-domain.com/api
VITE_API_BASE_URL=/api

# About page — fill these in for your deployment
VITE_APP_NAME=InstaAuto AI
VITE_COMPANY_NAME=Your Company Name
VITE_SUPPORT_EMAIL=support@yourdomain.com
VITE_WEBSITE_URL=https://yourdomain.com
VITE_PRIVACY_POLICY_URL=/privacy
VITE_DATA_DELETION_URL=/data-deletion
